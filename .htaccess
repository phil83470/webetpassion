# ==============================================================================
# FICHIER .HTACCESS — WEB & PASSION (HÉBERGEMENT O2SWITCH / APACHE)
# Optimisé pour : Sécurité, Performance, HTTPS et PWA (Calculateur de Devis)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENCODAGE DES CARACTÈRES & PAGE D'ACCUEIL PAR DÉFAUT
# ------------------------------------------------------------------------------
AddDefaultCharset UTF-8
DirectoryIndex index.html index.php

# ------------------------------------------------------------------------------
# 2. SÉCURITÉ DU SERVEUR
# ------------------------------------------------------------------------------
# Masquer les informations du serveur
ServerSignature Off

# Interdire le listage brut du contenu des répertoires
Options -Indexes

# Bloquer l'accès direct aux fichiers cachés et sensibles (.git, .env, .htaccess, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# En-têtes de protection HTTP
<IfModule mod_headers.c>
    # Empêcher le navigateur de deviner le type MIME (protection contre attaques MIME)
    Header set X-Content-Type-Options "nosniff"

    # Protection contre le détournement de clics (clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"

    # Contrôle des informations de provenance des requêtes
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Désactiver les fonctionnalités sensibles du navigateur non utilisées
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ------------------------------------------------------------------------------
# 3. REDIRECTIONS & RÉÉCRITURE (HTTPS)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forcer la connexion sécurisée en HTTPS (à commenter en local si pas de SSL)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Rediriger /index.html vers / sans boucle (DirectoryIndex)
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# ------------------------------------------------------------------------------
# 4. TYPES MIME ADDITIONNELS (WEBP, WOFF2, PWA)
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg .svgz
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType application/manifest+json .webmanifest .json
</IfModule>

# ------------------------------------------------------------------------------
# 5. RÈGLE SPÉCIALE SERVICE WORKER (PWA - APPLICATION DEVIS)
# Indispensable : le Service Worker ne doit jamais être mis en cache agressivement
# pour que les mises à jour de vos applications s'appliquent chez vos clients.
# ------------------------------------------------------------------------------
<FilesMatch "sw\.js$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set Service-Worker-Allowed "/"
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 6. COMPRESSION GZIP / DEFLATE (VITESSE DE CHARGEMENT)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------------------------
# 7. MISE EN CACHE NAVIGATEUR (EXPIRATION DU CACHE)
# Revalidation systématique pour HTML/CSS/JS afin que mobile et desktop
# reçoivent toujours la dernière version après chaque mise en ligne.
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"

    # Pages HTML, CSS et JS : revalidation immédiate
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"

    # Images : 1 an
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Polices d'écriture : 1 an
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # Documents PDF : 1 jour
    ExpiresByType application/pdf "access plus 1 day"

    # Manifest PWA : 1 jour
    ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

<FilesMatch "\.(html|htm|css|js)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</FilesMatch>

